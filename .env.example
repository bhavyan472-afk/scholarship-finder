# ScholarSphere environment variables.
# Local: copy to .env.  Vercel: Project → Settings → Environment Variables (set for Production,
# and for Preview with separate values). Never commit real values.

# ── Database (Neon Postgres) ───────────────────────────────────────────────
# REQUIRED. Pooled connection used by the app at runtime. In Neon's "Connection details", enable
# "Connection pooling" — the host contains "-pooler". Serverless functions open many short-lived
# connections; the pooler stops them exhausting Postgres' connection limit.
# connect_timeout gives a scaled-to-zero Neon compute time to wake up.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# REQUIRED. Direct (non-pooled) connection — same string WITHOUT "-pooler" and without pgbouncer=true.
# Used only by Prisma Migrate (`prisma migrate deploy` during the Vercel build), which needs
# features the pooler doesn't support.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Local development alternative (e.g. `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16`):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scholarsphere"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/scholarsphere"

# ── Auth (NextAuth) ────────────────────────────────────────────────────────
# REQUIRED in production. The canonical URL of the site, no trailing slash. NextAuth uses it to
# build sign-in callback URLs. Must match your production domain exactly (https://…).
NEXTAUTH_URL="http://localhost:3000"

# REQUIRED. Signs and encrypts session JWTs. Rotating it signs everyone out.
# Generate with: openssl rand -base64 32   (use a different value per environment)
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# OPTIONAL. Google sign-in; the button only appears when both are set.
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email reminders (SMTP via Nodemailer) ──────────────────────────────────
# REQUIRED in production for deadline reminders. If SMTP_HOST is empty, emails are only logged —
# fine for dev, but users would silently get nothing in production.
# Any SMTP provider works (Resend, Postmark, Amazon SES, SendGrid, Brevo…).
SMTP_HOST=""
# 587 = STARTTLS (most providers); 465 = implicit TLS.
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Sender. Its domain must be verified with your provider (SPF/DKIM), or mail lands in spam.
EMAIL_FROM="ScholarSphere <no-reply@your-domain.com>"

# ── Cron ───────────────────────────────────────────────────────────────────
# REQUIRED. Protects /api/cron/reminders. Vercel Cron automatically sends
# "Authorization: Bearer $CRON_SECRET" when this variable is set on the project.
# Requests without the exact header get 401; if unset, the endpoint rejects everything.
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-me-cron-secret"

# ── Public (inlined into the client bundle at BUILD time — redeploy after changing) ─
# REQUIRED in production. Canonical site URL for SEO tags, sitemap, robots.txt and links in
# emails. Usually identical to NEXTAUTH_URL. If unset on Vercel, falls back to the project's
# production domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OPTIONAL. Address shown on the Privacy/Terms/Disclaimer pages and footer. Must be a monitored
# inbox — the privacy policy promises replies to data requests within 30 days.
NEXT_PUBLIC_CONTACT_EMAIL="hello@your-domain.com"

# ── Seeding (only for scripts run from your machine; NOT needed on Vercel) ──
# `npm run db:seed:admin` creates or promotes this admin account. Password: 12+ characters.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# `npm run db:seed` (demo data + demo accounts with published passwords) refuses non-local
# databases. Set to 1 only for a throwaway dev/preview database — never production.
# ALLOW_DEMO_SEED="1"
