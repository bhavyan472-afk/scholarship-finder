// ScholarSphere data model (PostgreSQL — Neon in production, any Postgres locally).
//
// Schema changes go through migrations: `npm run db:migrate` locally, `prisma migrate deploy`
// on Vercel (see the `vercel-build` script).
//
// Enum-like fields are stored as String and validated with Zod (see lib/constants.ts),
// and list fields are stored as JSON-encoded strings (see lib/json.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app (Neon "-pooler" host); direct connection for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Auth (NextAuth) ─────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("STUDENT") // STUDENT | ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  profile      StudentProfile?
  saved        SavedScholarship[]
  applications Application[]
  reminders    Reminder[]

  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────── Domain ─────────────────────────

model StudentProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  country        String    @default("IN") // ISO-3166 alpha-2 (nationality)
  state          String? // Indian state code, e.g. "KA"
  educationLevel String? // CLASS_10 | CLASS_12 | DIPLOMA | UG | PG | PHD
  course         String? // ENGINEERING | MEDICAL | SCIENCE | ...
  marksType      String    @default("PERCENT") // PERCENT | CGPA
  marks          Float? // raw value as entered (percent or CGPA on 10)
  familyIncome   Int? // annual, INR
  category       String? // GENERAL | OBC | SC | ST | EWS
  isMinority     Boolean   @default(false)
  gender         String? // MALE | FEMALE | OTHER
  disability     Boolean   @default(false)
  dateOfBirth    DateTime?
  emailReminders Boolean   @default(true)
  onboardedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Scholarship {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  provider       String // organisation name
  providerType   String // GOVERNMENT | PRIVATE | INTERNATIONAL
  description    String
  amountInr      Int // normalised annual value in INR, used for filters/sorting
  amountLabel    String? // human label, e.g. "£18,000 stipend + full tuition"
  deadline       DateTime
  applyUrl       String
  documents      String    @default("[]") // JSON string[]
  benefits       String    @default("[]") // JSON string[]
  tags           String    @default("[]") // JSON string[]
  featured       Boolean   @default(false)
  isActive       Boolean   @default(true)
  // When an admin last checked the details against the official source. Null = never.
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rule         EligibilityRule?
  saved        SavedScholarship[]
  applications Application[]
  reminders    Reminder[]

  @@index([deadline])
  @@index([providerType])
  @@index([amountInr])
  @@index([isActive, deadline])
  @@index([featured])
}

// One rule set per scholarship. Empty JSON list ("[]") / null means "no restriction".
model EligibilityRule {
  id                 String  @id @default(cuid())
  scholarshipId      String  @unique
  maxFamilyIncome    Int? // INR / year
  minMarksPercent    Float?
  categories         String  @default("[]") // JSON Category[]
  minorityOnly       Boolean @default(false)
  states             String  @default("[]") // JSON state codes
  genders            String  @default("[]") // JSON Gender[]
  courses            String  @default("[]") // JSON Course[]
  educationLevels    String  @default("[]") // JSON EducationLevel[]
  countries          String  @default("[]") // JSON ISO codes (nationality)
  disabilityRequired Boolean @default(false)
  minAge             Int?
  maxAge             Int?

  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
}

model SavedScholarship {
  id            String   @id @default(cuid())
  userId        String
  scholarshipId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
  @@index([scholarshipId])
}

model Application {
  id            String    @id @default(cuid())
  userId        String
  scholarshipId String
  status        String    @default("SAVED") // SAVED | APPLYING | APPLIED | RESULT
  outcome       String? // AWARDED | REJECTED (only when status = RESULT)
  notes         String?
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
  @@index([userId, status])
}

model Reminder {
  id            String   @id @default(cuid())
  userId        String
  scholarshipId String
  kind          String // DAYS_7 | DAYS_1
  sentAt        DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  // Idempotency: each reminder kind is sent at most once per user+scholarship.
  @@unique([userId, scholarshipId, kind])
  @@index([sentAt])
}

// ───────────────────────── Infra ─────────────────────────

// Fixed-window rate-limit counters (lib/rate-limit.ts). Shared across serverless instances;
// expired rows are pruned by the daily cron.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
